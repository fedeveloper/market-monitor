[Unit]
Description=Market Monitor (azioni, ETF, crypto -> Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adatta User e percorsi alla tua installazione.
User=pi
WorkingDirectory=/home/pi/market-monitor
EnvironmentFile=/home/pi/market-monitor/.env
Environment=PYTHONPATH=/home/pi/market-monitor/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/market-monitor/.venv/bin/python -m market_monitor run
Restart=always
RestartSec=30
Nice=10

[Install]
WantedBy=multi-user.target
